# Database
POSTGRES_USER=payroll
POSTGRES_PASSWORD=payroll
POSTGRES_DB=payroll_db

# For running the API outside Docker. Under docker compose this is ignored:
# the API container always uses the compose database (db:5432), which is
# published on this machine as localhost:5433.
DATABASE_URL=postgresql://payroll:payroll@localhost:5433/payroll_db

# JWT
JWT_SECRET=replace-with-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend → backend (browser calls this URL)
NEXT_PUBLIC_API_URL=http://localhost:8000
