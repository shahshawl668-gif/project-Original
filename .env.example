# Database (used by backend + docker-compose)
MONGO_USER=payroll
MONGO_PASSWORD=payroll
MONGO_DB=payroll
MONGO_PORT=27017

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=payroll

# JWT
JWT_SECRET=replace-with-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend → backend (browser calls this URL)
NEXT_PUBLIC_API_URL=http://localhost:8000
